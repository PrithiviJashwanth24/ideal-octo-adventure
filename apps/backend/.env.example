# ─────────────────────────────────────────
# FITCHECK BACKEND — ENVIRONMENT VARIABLES
# Copy to .env and fill in values
# ─────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://fitcheck:password@localhost:5432/fitcheck

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=your_64_char_access_secret_here
JWT_REFRESH_SECRET=your_64_char_refresh_secret_here

# OpenAI
OPENAI_API_KEY=sk-...

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=fitcheck-media-dev
CDN_URL=https://cdn.fitcheck.ai

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Firebase (push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# App
ALLOWED_ORIGINS=http://localhost:3000,exp://localhost:19000
LOG_LEVEL=debug
